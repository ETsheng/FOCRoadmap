"cubemx\stm32f1xx_hal_gpio_ex.o"
"cubemx\stm32f1xx_hal_adc.o"
"cubemx\stm32f1xx_hal_adc_ex.o"
"cubemx\stm32f1xx_hal.o"
"cubemx\stm32f1xx_hal_rcc.o"
"cubemx\stm32f1xx_hal_rcc_ex.o"
